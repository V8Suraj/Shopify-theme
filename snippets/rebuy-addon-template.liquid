<script>
    (function() {
    function setAddonTitle() {
        const titleEl = document.querySelector('#rebuy-widget-297119 .primary-title');
        if (titleEl && titleEl.textContent.trim() !== 'TeinPro Perk: FREE Gift on Orders ₹1499+') {
            titleEl.textContent = 'TeinPro Perk: FREE Gift on Orders ₹1499+';
        }
    }

    setAddonTitle();

    const observer = new MutationObserver(setAddonTitle);
    observer.observe(document.body, { childList: true, subtree: true });
})();
</script>
<script>
window.rebuyMainProductPrice = {{ product.selected_or_first_available_variant.price | default: 0 }};

window.rebuyAddonTotalWithMain = function(addonSubtotal) {
  addonSubtotal = Number(addonSubtotal || 0);
  var mainPrice = Number(window.rebuyMainProductPrice || 0);

  if (addonSubtotal <= 0) return addonSubtotal;

  return addonSubtotal + mainPrice;
};
</script>

