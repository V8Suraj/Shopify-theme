<script>
/* FBT review stars: reads rating + count from each product's own page, then draws Judge.me native font stars */
(function () {
  var cache = {};

  function starsHTML(rating) {
    var shown = Math.round(rating * 2) / 2; // native theme rounds to the nearest half star
    var pct = Math.max(0, Math.min(5, shown)) / 5 * 100;
    return '<span class="fbt-empty"></span><span class="fbt-fill" style="width:' + pct + '%"></span>';
  }

  function findAggregate(o) {
    if (!o || typeof o !== 'object') return null;
    if (o.aggregateRating) return o.aggregateRating;
    var keys = Object.keys(o);
    for (var i = 0; i < keys.length; i++) {
      var r = findAggregate(o[keys[i]]);
      if (r) return r;
    }
    return null;
  }

  function parsePage(html) {
    var doc = new DOMParser().parseFromString(html, 'text/html');
    var rating = null, count = null;

    // 1) JSON-LD aggregateRating (most reliable)
    var lds = doc.querySelectorAll('script[type="application/ld+json"]');
    for (var i = 0; i < lds.length && !rating; i++) {
      try {
        var ar = findAggregate(JSON.parse(lds[i].textContent));
        if (ar) {
          rating = parseFloat(ar.ratingValue);
          count = parseInt(ar.reviewCount || ar.ratingCount, 10);
        }
      } catch (e) {}
    }

    // 2) Judge.me preview badge data attributes
    if (!rating || !count) {
      var badge = doc.querySelector('.jdgm-prev-badge[data-average-rating]');
      if (badge) {
        rating = parseFloat(badge.getAttribute('data-average-rating'));
        count = parseInt(badge.getAttribute('data-number-of-reviews'), 10);
      }
    }

    // 3) Theme rating block (aria-label + visible text)
    if (!rating || !count) {
      var wrap = doc.querySelector('.rating-wrapper');
      var r = wrap && wrap.querySelector('.rating[aria-label]');
      if (r) {
        var m = r.getAttribute('aria-label').match(/(\d+(\.\d+)?)/);
        var c = wrap.textContent.match(/(\d[\d,]*)/);
        if (m) rating = parseFloat(m[1]);
        if (c) count = parseInt(c[1].replace(/,/g, ''), 10);
      }
    }

    return (rating && count) ? { rating: rating, count: count } : null;
  }

  function fill(el) {
    if (el.getAttribute('data-fbt-done')) return;
    var url = el.getAttribute('data-url');
    if (!url) return;
    el.setAttribute('data-fbt-done', '1');

    if (!cache[url]) {
      cache[url] = fetch(url, { credentials: 'same-origin' })
        .then(function (r) { return r.text(); })
        .then(parsePage)
        .catch(function () { return null; });
    }
    cache[url].then(function (d) {
      if (!d) { console.warn('[FBT reviews] no rating found for', url); return; }
      el.setAttribute('aria-label', 'Rating of this product is ' + d.rating.toFixed(2) + ' out of 5');
      el.innerHTML = '<span class="fbt-stars">' + starsHTML(d.rating) + '</span>' +
                     '<span class="fbt-review-label">' + d.count + (d.count === 1 ? ' review' : ' reviews') + '</span>';
    });
  }

  function run() {
    var els = document.querySelectorAll('#rebuy-bundle-widget .fbt-review[data-url]');
    for (var i = 0; i < els.length; i++) fill(els[i]);
  }

  var t;
  new MutationObserver(function () { clearTimeout(t); t = setTimeout(run, 150); })
    .observe(document.documentElement, { childList: true, subtree: true });
  run();
})();
</script>