  <script>
  (function() {
    function addHoverImage(block) {
        const media = block.querySelector('.rebuy-product-media');
        const link = block.querySelector('.rebuy-product-title-link');
        if (!media || !link) return;

        const href = link.getAttribute('href');
        const handle = href?.split('/products/')[1]?.split('?')[0];
        if (!handle) return;

        // Make the media block clickable (only wire it up once)
        if (!media.dataset.clickBound) {
            media.dataset.clickBound = 'true';
            media.style.cursor = 'pointer';
            media.addEventListener('click', function() {
                window.location.href = href;
            });
        }

        if (media.querySelector('.rebuy-hover-img')) return;

        fetch(`/products/${handle}.js`)
            .then(res => res.json())
            .then(product => {
                if (product.images && product.images.length > 1) {
                    const hoverImg = document.createElement('img');
                    hoverImg.src = product.images[1];
                    hoverImg.className = 'rebuy-hover-img';
                    media.style.position = 'relative';
                    hoverImg.style.position = 'absolute';
                    hoverImg.style.top = '0';
                    hoverImg.style.left = '0';
                    hoverImg.style.width = '100%';
                    hoverImg.style.height = '100%';
                    hoverImg.style.objectFit = 'cover';
                    hoverImg.style.opacity = '0';
                    hoverImg.style.transition = 'opacity 0.3s ease';
                    media.appendChild(hoverImg);
                }
            })
            .catch(err => console.log('Rebuy hover fetch error:', err));
    }

    function scanWidget() {
        document.querySelectorAll('#rebuy-widget-297025 .rebuy-product-block').forEach(addHoverImage);
    }

    // Run once in case widget already exists
    scanWidget();

    // Watch for Rebuy rendering/re-rendering the widget
    const observer = new MutationObserver(scanWidget);
    observer.observe(document.body, { childList: true, subtree: true });
})();
</script>
