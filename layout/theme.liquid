/* Review row in every Rebuy widget */
.rebuy-widget .rebuy-product-review[data-rnr] {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important; /* use flex-start for left-aligned */
  gap: 8px !important;
  margin: 8px 0 !important;
  padding: 0 !important;
  font-size: 14px !important;
  line-height: 1.2 !important;
}

/* Judge.me native star (icon font) */
.rnr-stars {
  position: relative;
  display: inline-block;
  flex: none;
  font-family: 'JudgemeStar' !important;
  font-size: 13px;
  line-height: 1;
  letter-spacing: 5px !important;      /* gap between stars */
  color: #FFA800;
  -webkit-text-stroke: 1.3px #FFA800;  /* stroke on the orange stars */
  white-space: nowrap;
}

/* bottom layer: solid cream stars (unfilled colour) */
.rnr-stars .rnr-empty::before {
  content: "\e000\e000\e000\e000\e000";
  color: #fff4dc;
  -webkit-text-stroke: 20;
}

/* top layer: orange stars, clipped to the rating width */
.rnr-stars .rnr-fill {
  position: absolute;
  left: 0;
  top: 0;
  overflow: hidden;
  white-space: nowrap;
}
.rnr-stars .rnr-fill::before {
  content: "\e000\e000\e000\e000\e000";
  color: #FFA800;
}

.rnr-label {
  font-family: 'Montserrat', sans-serif;
  font-size: 14px;
  font-weight: 400;
  color: rgba(0, 0, 0, .81);
  white-space: nowrap;
}

/* Show the review row ABOVE the product title (remove this block to put it back under the title) */
.rebuy-widget .rebuy-product-info {
  display: flex !important;
  flex-direction: column !important;
}
.rebuy-widget .rebuy-product-info .rebuy-product-review {
  order: -1 !important;
  margin: 6px 0 6px !important;
}
/* Mobile only: keep the stars + review count inside the card */
@media (max-width: 768px) {
  .rebuy-widget .rebuy-product-review[data-rnr] {
    gap: 5px !important;
    max-width: 100% !important;
    min-width: 0 !important;
    flex-wrap: nowrap !important;
    justify-content: center !important;
  }
  .rebuy-widget .rnr-stars {
    font-size: 11px !important;
    letter-spacing: 2px !important;
    -webkit-text-stroke-width: 0.4px;
  }
  .rebuy-widget .rnr-label {
    font-size: 12px !important;
    min-width: 0;
  }
}

</style>

<script>
(function () {
  function getRating(el) {
    var fg = el.querySelector('[class*="foreground"]');
    if (fg && fg.style.width) return parseFloat(fg.style.width) / 100 * 5;
    var lbl = el.querySelector('[aria-label]');
    var m = lbl && lbl.getAttribute('aria-label').match(/(\d+(\.\d+)?)/);
    return m ? parseFloat(m[1]) : null;
  }

  function process() {
    document.querySelectorAll('.rebuy-widget .rebuy-product-review:not([data-rnr])').forEach(function (el) {
      var rating = getRating(el);
      var countEl = el.querySelector('.rebuy-review-count-number');
      if (rating === null || !countEl) { console.warn('Review row not parsed', el); return; }
      var count = parseInt(countEl.textContent.replace(/\D/g, ''), 10) || 0;
      var pct = Math.max(0, Math.min(5, rating)) / 5 * 100;

      el.setAttribute('data-rnr', '1');
      el.setAttribute('aria-label', 'Rating of this product is ' + rating.toFixed(2) + ' out of 5');
      el.innerHTML =
        '<div class="rnr-stars">' +
          '<span class="rnr-empty"></span>' +
          '<span class="rnr-fill" style="width:' + pct + '%"></span>' +
        '</div>' +
        '<span class="rnr-label">' + count + (count === 1 ? ' review' : ' reviews') + '</span>';
    });
  }

  process();
  var t;
  new MutationObserver(function () { clearTimeout(t); t = setTimeout(process, 150); })
    .observe(document.body, { childList: true, subtree: true });
})();
</script>
  </body>
