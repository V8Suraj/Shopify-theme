{% comment %}
  Teinpro - GWP checkout guard (v6)
  Whenever the cart changes, the checkout button shows a spinner and can't be clicked until
  the cart holds exactly the gift(s) it should:
    - gift for the tier reached is present (waits for the Rebuy GWP widget to add it)
    - a gift from a lower tier is gone once a higher tier is reached (EXCLUSIVE_TIERS)
    - a gift whose tier is no longer reached is gone
  The script never adds gifts. It only removes a leftover gift if Rebuy hasn't (REMOVE_LEFTOVER_GIFT).
  Safety: after MAX_WAIT_MS (or on any error) the spinner clears and checkout is allowed.
{% endcomment %}
<style>
  :root {
    --gwp-spinner-color: #ffffff;           /* use a dark colour if the checkout button is light */
    --gwp-spinner-track: rgba(255, 255, 255, 0.35);
    --gwp-spinner-size: 20px;
  }

  .gwp-loading,
  body.gwp-pending .gokwik-checkout button,
  body.gwp-pending .rebuy-cart__checkout-button,
  body.gwp-pending button[name="checkout"] {
    position: relative !important;
    pointer-events: none !important;
    cursor: progress !important;
    color: transparent !important;
    text-shadow: none !important;
  }

  .gwp-loading > *,
  .gwp-loading svg,
  .gwp-loading img,
  body.gwp-pending .gokwik-checkout button > *,
  body.gwp-pending .rebuy-cart__checkout-button > *,
  body.gwp-pending button[name="checkout"] > * {
    opacity: 0 !important;
  }

  .gwp-loading::after,
  body.gwp-pending .gokwik-checkout button::after,
  body.gwp-pending .rebuy-cart__checkout-button::after,
  body.gwp-pending button[name="checkout"]::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--gwp-spinner-size);
    height: var(--gwp-spinner-size);
    margin: calc(var(--gwp-spinner-size) / -2) 0 0 calc(var(--gwp-spinner-size) / -2);
    border: 2.5px solid var(--gwp-spinner-track);
    border-top-color: var(--gwp-spinner-color);
    border-radius: 50%;
    box-sizing: border-box;
    animation: gwp-spin 0.7s linear infinite;
    z-index: 5;
  }

  @keyframes gwp-spin {
    to { transform: rotate(360deg); }
  }
</style>

<script>
(function () {
  if (window.__gwpGuardLoaded) return;
  window.__gwpGuardLoaded = true;

  // ---------- CONFIG ----------
  // Keep TIERS ordered from lowest to highest threshold.
  var TIERS = [
    { id: 51568075440449, threshold: 79900  },  // Sample Bars worth Rs.199 - at Rs.799
    { id: 67600182247745, threshold: 149900 }   // Mystery Gift - at Rs.1,499
  ];

  // true  = only the highest tier's gift stays (Mystery Gift replaces Sample Bars)
  // false = every earned gift stays (cumulative)
  var EXCLUSIVE_TIERS = true;

  // If a gift that should be gone is still in the cart after REMOVE_AFTER_MS,
  // remove it ourselves (Rebuy normally does this, this is the safety net).
  var REMOVE_LEFTOVER_GIFT = true;
  var REMOVE_AFTER_MS = 1500;

  var CHECKOUT_SELECTOR =
    '.gokwik-checkout button, .gokwik-checkout, .rebuy-cart__checkout-button, button[name="checkout"]';

  var POLL_MS = 250;          // how often to re-check the cart
  var MIN_SPINNER_MS = 600;   // after a cart change, always give Rebuy at least this long to react
  var MAX_WAIT_MS = 10000;    // give up waiting after this long and release the button

  // Cart-changing requests that trigger the spinner (/cart.js reads are ignored)
  var CART_MUTATION = /\/cart\/(add|change|update|clear)(\.js)?(\?|$)/;

  // ---------- HELPERS ----------
  var tierIds = TIERS.map(function (t) { return t.id; });
  function isGift(id) { return tierIds.indexOf(id) !== -1; }
  function sleep(ms)  { return new Promise(function (r) { setTimeout(r, ms); }); }

  var nativeFetch = window.fetch.bind(window);

  function getCart() {
    return nativeFetch('/cart.js', { cache: 'no-store' }).then(function (r) { return r.json(); });
  }

  // What should the gift lines look like for this cart?
  function analyze(cart) {
    var real = cart.items.filter(function (i) { return !isGift(i.variant_id); });
    var spend = real.reduce(function (s, i) { return s + i.final_line_price; }, 0);

    var earned = TIERS.filter(function (t) {
      return real.length > 0 && spend >= t.threshold;
    });
    var expected = EXCLUSIVE_TIERS ? earned.slice(-1) : earned;
    var expectedIds = expected.map(function (t) { return t.id; });

    var missing = expectedIds.filter(function (id) {
      return !cart.items.some(function (i) { return i.variant_id === id; });
    });
    var leftover = cart.items.filter(function (i) {
      return isGift(i.variant_id) && expectedIds.indexOf(i.variant_id) === -1;
    });

    return {
      ready: missing.length === 0 && leftover.length === 0,
      leftover: leftover
    };
  }

  // remove a leftover gift (never more than once every 3s)
  var lastRemoval = 0;
  function removeLeftover(lines) {
    if (Date.now() - lastRemoval < 3000) return Promise.resolve();
    lastRemoval = Date.now();
    var updates = {};
    lines.forEach(function (l) { updates[l.key] = 0; });
    // window.fetch (wrapped) so Rebuy and this guard both see the change
    return window.fetch('/cart/update.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ updates: updates })
    }).catch(function () {});
  }

  // resolves true when the cart is correct, false on timeout
  function waitForGifts(minMs) {
    var start = Date.now();
    function step() {
      return getCart().then(function (cart) {
        var elapsed = Date.now() - start;
        var a = analyze(cart);

        if (a.ready && elapsed >= (minMs || 0)) return true;
        if (elapsed > MAX_WAIT_MS) return false;

        if (!a.ready && REMOVE_LEFTOVER_GIFT && a.leftover.length && elapsed >= REMOVE_AFTER_MS) {
          return removeLeftover(a.leftover).then(function () { return sleep(POLL_MS); }).then(step);
        }
        return sleep(POLL_MS).then(step);
      });
    }
    return step();
  }

  // ---------- PENDING STATE (body class survives Smart Cart re-renders) ----------
  var token = 0;

  function setPending(on) {
    if (document.body) document.body.classList.toggle('gwp-pending', on);
  }

  // a cart request just started: show spinner right away
  function begin() {
    var my = ++token;
    setPending(true);
    setTimeout(function () {                // failsafe if the request never reports back
      if (my === token) setPending(false);
    }, MAX_WAIT_MS + 5000);
  }

  // a cart request finished: keep spinner until the cart is really correct
  function settle() {
    var my = ++token;
    setPending(true);
    waitForGifts(MIN_SPINNER_MS)
      .catch(function () { return false; })
      .then(function () {
        if (my === token) setPending(false);  // a newer cart change keeps the spinner on
      });
  }

  // ---------- DETECT CART CHANGES: fetch ----------
  window.fetch = function (input) {
    var url = typeof input === 'string' ? input : (input && input.url) || '';
    var isMutation = CART_MUTATION.test(url);
    if (isMutation) begin();
    var p = nativeFetch.apply(window, arguments);
    if (isMutation) {
      p.then(settle, settle);               // does not change the promise returned to the caller
    }
    return p;
  };

  // ---------- DETECT CART CHANGES: XMLHttpRequest ----------
  var xhrOpen = XMLHttpRequest.prototype.open;
  var xhrSend = XMLHttpRequest.prototype.send;
  XMLHttpRequest.prototype.open = function (method, url) {
    this.__gwpMutation = CART_MUTATION.test(String(url || ''));
    return xhrOpen.apply(this, arguments);
  };
  XMLHttpRequest.prototype.send = function () {
    if (this.__gwpMutation) {
      begin();
      this.addEventListener('loadend', settle);
    }
    return xhrSend.apply(this, arguments);
  };

  // Rebuy's own cart event, as an extra trigger
  document.addEventListener('rebuy:cart.change', settle);

  // ---------- CLICK INTERCEPT (for clicks that land before any cart change was seen) ----------
  var busy = false;

  window.addEventListener('click', function (e) {
    var btn = e.target.closest && e.target.closest(CHECKOUT_SELECTOR);
    if (!btn) return;

    if (btn.dataset.gwpBypass === 'true') {   // our own re-fired click
      btn.dataset.gwpBypass = 'false';
      return;
    }

    e.preventDefault();
    e.stopPropagation();
    e.stopImmediatePropagation();

    if (busy) return;
    busy = true;
    btn.classList.add('gwp-loading');

    function go() {
      busy = false;
      btn.classList.remove('gwp-loading');
      btn.dataset.gwpBypass = 'true';
      btn.click();
    }

    waitForGifts(0).then(go, go);
  }, true);

  // ---------- strip ?variant= from URL ----------
  (function () {
    var url = new URL(window.location.href);
    if (url.searchParams.has('variant')) {
      url.searchParams.delete('variant');
      window.history.replaceState({}, document.title, url.pathname + url.search);
    }
  })();
})();
</script>
