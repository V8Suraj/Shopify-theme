<script>
  console.log('Ready Callback box is executing');

  {% comment %} document.addEventListener('rebuy:smartcart.ready', function (event) {
  console.log('rebuy:smartcart.ready event fired');
  attachCartIconHijack(event.detail.smartcart);
}); {% endcomment %}

document.addEventListener('rebuy:smartcart.ready', function (event) {
  console.log('rebuy:smartcart.ready event fired');
  attachCartIconHijack(event.detail.smartcart);
});

function attachCartIconHijack(smartcart) {
  console.log('Attaching hijack, smartcart instance:', smartcart);

  document.addEventListener(
    'click',
    function (e) {
      var trigger = e.target.closest('cart-drawer-component.cart-drawer > button');
      if (!trigger) return;

      console.log('Cart icon click intercepted');
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();
      smartcart.show();
    },
    true
  );
}

(function () {
  var dialog = document.querySelector('dialog.cart-drawer__dialog');
  if (!dialog) return;

  dialog.addEventListener('close', function () {
    dialog.style.visibility = '';
  });

  var observer = new MutationObserver(function () {
    if (dialog.hasAttribute('open')) {
      dialog.style.visibility = 'hidden';

      var closeBtn = document.querySelector('.cart-drawer__close-button');
      if (closeBtn) {
        closeBtn.click();
      } else {
        dialog.close();
      }
    }
  });

  observer.observe(dialog, { attributes: true, attributeFilter: ['open'] });
})();
</script>

