
{% doc %}
  @prompt
    i want copy right section with editable form, shop name edit, years edit with mobile optimized and also want font size colors, also want designed by option with linkable 
{% enddoc %}
 
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}

{% comment %} This Code is added by Suraj (2 sep 11Pm trying to remove white border at the end) {% endcomment %}
{% comment %} html,
body {
  margin: 0 !important;
  padding: 0 !important;
}

footer,
.footer,
.shopify-section,
.shopify-section-group-footer-group {
  margin: 0 !important;
  padding: 0 !important;
  border: 0 !important;
  border-radius: 0 !important;
  box-shadow: none !important;
} {% endcomment %}

.ai-copyright-section-{{ ai_gen_id }} {
  display: block;
  width: 100%;
  padding: 45px 0;
  background-color: {{ block.settings.background_color }};
  text-align: {{ block.settings.text_alignment }};
}
.ai-copyright-container-{{ ai_gen_id }} {
  width: 100%;
  max-width: none;
  margin: 0;
  position: relative;

  display: flex;
  align-items: center;
  justify-content: center;
}

/* COPYRIGHT TEXT */
.ai-copyright-text-{{ ai_gen_id }} {
  color: {{ block.settings.text_color }};
  font-size: {{ block.settings.font_size }}px;
  line-height: 1.5;
  margin: 0;
  padding: 0;

  text-align: center;
  white-space: nowrap;
}

/* PAYMENT CARDS - DESKTOP */
.payment-methods-image {
  width: 500px !important;
  height: 150px !important;
  object-fit: contain;
  display: block;

  position: absolute;
  right: {{ block.settings.payment_position }}px;
  top: 50%;
  transform: translateY(-50%);

  margin: 0 !important;
  padding: 0 !important;
}

/* LINKS */
.ai-copyright-link-{{ ai_gen_id }} {
  color: {{ block.settings.link_color }};
  text-decoration: none;
  transition: color 0.3s ease;
}

.ai-copyright-link-{{ ai_gen_id }}:hover {
  color: {{ block.settings.link_hover_color }};
  text-decoration: underline;
}

/* SEPARATOR */
.ai-copyright-separator-{{ ai_gen_id }} {
  margin: 0 8px;
}


/* =========================
   MOBILE
   ========================= */

@media screen and (max-width: 749px) {

  .ai-copyright-section-{{ ai_gen_id }} {
    padding: {{ block.settings.mobile_padding_top }}px
             {{ block.settings.mobile_padding_horizontal }}px
             {{ block.settings.mobile_padding_bottom }}px;
  }

  .ai-copyright-container-{{ ai_gen_id }} {
    width: 100%;
    position: relative;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    gap: 4px;
  }

  .ai-copyright-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.mobile_font_size }}px;
    line-height: 1.4;

    margin: 0 !important;
    padding: 0 !important;

    text-align: center;
    white-space: normal;
  }

  /* PAYMENT CARDS BELOW COPYRIGHT */
  .payment-methods-image {
    position: static;

    width: 283px !important;
    height: 90px !important;

    transform: none;

    display: block;
    margin: 1px auto 0 !important;
    padding: 0 !important;
  }

  .ai-copyright-separator-{{ ai_gen_id }} {
    margin: 0 4px;
  }
}

{% endstyle %}

<copyright-section-{{ ai_gen_id }}
  class="ai-copyright-section-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-copyright-container-{{ ai_gen_id }}">
    <p class="ai-copyright-text-{{ ai_gen_id }}">
      {% if block.settings.copyright_symbol %}©{% endif %}
      {% if block.settings.show_year %}
        {% if block.settings.year_type == 'current' %}
          {{ 'now' | date: '%Y' }}
        {% else %}
          {{ block.settings.custom_year }}
        {% endif %}
      {% endif %}
      {% if block.settings.show_shop_name %}
        {% if block.settings.shop_name != blank %}
          {{ block.settings.shop_name }}
        {% else %}
          {{ shop.name }}
        {% endif %}
      {% endif %}
      {% if block.settings.additional_text != blank %}
        {{ block.settings.additional_text }}
      {% endif %}
      {% if block.settings.show_designed_by and block.settings.designer_name != blank %}
        <span class="ai-copyright-separator-{{ ai_gen_id }}">|</span>
        Designed by
        {% if block.settings.designer_link != blank %}
          <a href="{{ block.settings.designer_link }}" class="ai-copyright-link-{{ ai_gen_id }}" target="_blank" rel="noopener">{{ block.settings.designer_name }}</a>
        {% else %}
          {{ block.settings.designer_name }}
        {% endif %}
      {% endif %}
    </p>
<img 
  src="https://cdn.shopify.com/s/files/1/0951/5122/7201/files/group_1321324419.webp?v=1774438357"
  class="payment-methods-image"
  alt="Payment methods"
/>
  </div>
</copyright-section-{{ ai_gen_id }}>

<script>
  (function() {
    class CopyrightSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('copyright-section-{{ ai_gen_id }}', CopyrightSection{{ ai_gen_id }});
  })();
</script>

{% schema %}


{
  "name": "Copyright section",
  "tag": null,
  "settings": [
    {
      "type": "header",
