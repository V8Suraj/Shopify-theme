      "default": "2026"
    },
    {
      "type": "checkbox",
      "id": "show_shop_name",
      "label": "Show shop name",
      "default": true
    },
    {
      "type": "text",
      "id": "shop_name",
      "label": "Shop name"
    },
    {
      "type": "text",
      "id": "additional_text",
      "label": "Additional text",
      "default": "All rights reserved."
    },
    {
      "type": "header",
      "content": "Designed by"
    },
    {
      "type": "checkbox",
      "id": "show_designed_by",
      "label": "Show designed by",
      "default": false
    },
    {
      "type": "text",
      "id": "designer_name",
      "label": "Designer name",
      "default": "Your Company"
    },
    {
      "type": "url",
