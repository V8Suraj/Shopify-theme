{% schema %}
{
  "name": "Marquee Text",

  "settings": [

    {
      "type": "color",
      "id": "colorBackground",
      "label": "Background color",
      "default": "#000000"
    },

    {
      "type": "color",
      "id": "colorText",
      "label": "Text color",
      "default": "#ffffff"
    },

    {
      "type": "textarea",
      "id": "marquee_text",
      "label": "Marquee text",
      "default": "30% OFF ACROSS ALL ORDERS • USE SAVARKAR30 • 48 HOURS ONLY"
    },

    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },

    {
      "type": "text",
      "id": "logo_alt",
      "label": "Logo alt text",
      "default": "Logo"
    },

    {
      "type": "url",
      "id": "link",
      "label": "Marquee link"
    },


    {
      "type": "header",
      "content": "Desktop"
    },

    {
      "type": "range",
      "id": "marquee_height",
      "min": 40,
      "max": 160,
      "step": 2,
      "default": 60,
      "label": "Marquee height"
    },

    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 60,
      "step": 2,
      "default": 18,
      "label": "Text size"
    },

    {
      "type": "range",
      "id": "logo_width",
      "min": 20,
      "max": 200,
      "step": 5,
      "default": 50,
      "label": "Logo width"
    },

    {
      "type": "range",
      "id": "logo_height",
      "min": 20,
      "max": 200,
      "step": 5,
      "default": 50,
      "label": "Logo height"
    },

    {
      "type": "range",
      "id": "logo_margin_left",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 20,
      "label": "Logo left spacing"
    },

    {
      "type": "range",
      "id": "logo_margin_right",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 20,
      "label": "Logo right spacing"
    },

    {
      "type": "range",
      "id": "unit_gap",
      "min": 20,
      "max": 200,
      "step": 5,
      "default": 60,
      "label": "Gap between repeats"
    },

    {
      "type": "range",
      "id": "speed",
      "min": 5,
      "max": 60,
      "step": 5,
      "default": 20,
      "label": "Marquee speed"
    },


    {
      "type": "header",
      "content": "Mobile"
    },

    {
      "type": "range",
      "id": "mobile_height",
      "min": 30,
      "max": 100,
      "step": 2,
      "default": 44,
      "label": "Mobile height"
    },

    {
      "type": "range",
      "id": "mobile_font_size",
      "min": 10,
      "max": 40,
      "step": 2,
      "default": 14,
      "label": "Mobile text size"
    },

    {
      "type": "range",
      "id": "mobile_logo_width",
      "min": 20,
      "max": 100,
      "step": 5,
      "default": 35,
      "label": "Mobile logo width"
    },

    {
      "type": "range",
      "id": "mobile_logo_height",
      "min": 20,
      "max": 100,
      "step": 5,
      "default": 35,
      "label": "Mobile logo height"
    },

    {
      "type": "range",
      "id": "mobile_logo_margin_left",
      "min": 0,
      "max": 50,
      "step": 5,
      "default": 10,
      "label": "Mobile logo left spacing"
    },

    {
      "type": "range",
      "id": "mobile_logo_margin_right",
      "min": 0,
