<style>
  .section-{{ section.id }}.custom-marquee {
    width: 100%;
    height: {{ section.settings.marquee_height }}px;
    overflow: hidden;
    display: flex;
    align-items: center;
    background: {{ section.settings.colorBackground }};
    color: {{ section.settings.colorText }};
  }

  .section-{{ section.id }} .marquee-link {
    width: 100%;
    overflow: hidden;
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .section-{{ section.id }} .marquee-track {
    display: flex;
    width: max-content;
    align-items: center;
    animation: marquee-{{ section.id }} {{ section.settings.speed }}s linear infinite;
    will-change: transform;
  }

  /* ONE COMPLETE REPEATING UNIT */
  .section-{{ section.id }} .marquee-unit {
    display: flex;
    align-items: center;
    flex-shrink: 0;

    margin-right: {{ section.settings.unit_gap }}px;
  }

  /* TEXT */
  .section-{{ section.id }} .marquee-text {
    display: inline-block;
    font-size: {{ section.settings.font_size }}px;
    line-height: 1;
    white-space: nowrap;
  }

  /* LOGO */
  .section-{{ section.id }} .marquee-logo {
    display: block;

    width: {{ section.settings.logo_width }}px;
    height: {{ section.settings.logo_height }}px;

    object-fit: contain;
    flex-shrink: 0;

    margin-left: {{ section.settings.logo_margin_left }}px;
    margin-right: {{ section.settings.logo_margin_right }}px;
  }

  @keyframes marquee-{{ section.id }} {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-50%);
    }
  }

  /* MOBILE */

  @media screen and (max-width: 749px) {

    .section-{{ section.id }}.custom-marquee {
      height: {{ section.settings.mobile_height }}px;
    }

    .section-{{ section.id }} .marquee-text {
      font-size: {{ section.settings.mobile_font_size }}px;
    }

    .section-{{ section.id }} .marquee-logo {
      width: {{ section.settings.mobile_logo_width }}px;
      height: {{ section.settings.mobile_logo_height }}px;

      margin-left: {{ section.settings.mobile_logo_margin_left }}px;
      margin-right: {{ section.settings.mobile_logo_margin_right }}px;
    }

  }
</style>


