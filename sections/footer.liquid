    },

    {
      "type": "image_picker",
      "id": "icon_1",
      "label": "Icon 1"
    },
    {
      "type": "url",
      "id": "link_1",
      "label": "Link 1"
    },

    {
      "type": "image_picker",
      "id": "icon_2",
      "label": "Icon 2"
    },
    {
      "type": "url",
      "id": "link_2",
      "label": "Link 2"
    },

    {
      "type": "image_picker",
      "id": "icon_3",
      "label": "Icon 3"
    },
    {
      "type": "url",
      "id": "link_3",
      "label": "Link 3"
    },

    {
      "type": "image_picker",
      "id": "icon_4",
      "label": "Icon 4"
    },
    {
      "type": "url",
      "id": "link_4",
      "label": "Link 4"
    },

    {
      "type": "image_picker",
      "id": "icon_5",
      "label": "Icon 5"
    },
    {
      "type": "url",
      "id": "link_5",
      "label": "Link 5"
