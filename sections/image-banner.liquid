<section class="service-section service-{{ section.id }}">
  <div class="service-inner-wrap ">

    {% if section.settings.desktop_image != blank %}
      <img
        class="desktop-image"
        src="{{ section.settings.desktop_image | image_url }}"
        alt="{{ section.settings.desktop_image.alt | escape }}"
        loading="lazy" width="" height=""
      >
    {% endif %}

    {% if section.settings.mobile_image != blank %}
      <img
        class="mobile-image"
        src="{{ section.settings.mobile_image | image_url }}"
        alt="{{ section.settings.mobile_image.alt | escape }}"
        loading="lazy" width="" height=""
      >
    {% endif %}

  </div>
</section>

<style>
  .service-section .mobile-image {
    display: none;
  }
  .service-section img {
    width: 100%;
    display: flex;
  }
  .service-{{ section.id }}.service-section {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media screen and (max-width: 768px) {
    .service-section .desktop-image {
      display: none;
    }
    .service-section .mobile-image {
      display: block;
    }
    .service-{{ section.id }}.service-section {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
</style>

{% schema %}
{
  "name": "Image banner section",
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top (Desktop)",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom (Desktop)",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top (Mobile)",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom (Mobile)",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Image banner section",
      "category": "Custom"
    }
  ]
}
{% endschema %}
