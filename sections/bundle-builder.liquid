/* =========================================================
   SHARED ANIMATIONS
========================================================= */

@keyframes bbCartPulse {
  0%   { box-shadow: 0 0 0 0 rgba(167, 25, 32, .45); transform: scale(1); }
  30%  { transform: scale(1.04); }
  100% { box-shadow: 0 0 0 18px rgba(167, 25, 32, 0); transform: scale(1); }
}

@keyframes bbPop {
  0%   { transform: scale(1); }
  40%  { transform: scale(1.3); }
  100% { transform: scale(1); }
}

@keyframes bbShimmer {
  from { background-position: 0% 0; }
  to   { background-position: 200% 0; }
}


/* =========================================================
   CONFETTI (appended to <body>, so not section-scoped)
========================================================= */

.bb-confetti-layer {
  position: fixed;
  inset: 0;
  z-index: 2147483000;
  overflow: hidden;
  pointer-events: none;
}

.bb-confetti-piece {
  position: absolute;
  left: var(--x);
  top: var(--y);
  width: var(--w);
  height: var(--h);
  margin: calc(var(--h) / -2) 0 0 calc(var(--w) / -2);
  background: var(--c);
  border-radius: var(--r);
  opacity: 0;
  will-change: transform, opacity;
  animation:
    bbConfettiMove var(--dur) var(--delay) both,
    bbConfettiFade var(--dur) var(--delay) both;
}

@keyframes bbConfettiMove {
  0% {
    transform: translate3d(0, 0, 0) rotate3d(1, .3, .2, 0deg);
    animation-timing-function: cubic-bezier(.15, .75, .35, 1);
  }
  32% {
    transform: translate3d(var(--dx), var(--dy), 0) rotate3d(1, .3, .2, calc(var(--rot) * .45));
    animation-timing-function: cubic-bezier(.45, 0, .85, .6);
  }
  100% {
    transform:
      translate3d(calc(var(--dx) + var(--drift)), calc(var(--dy) + var(--fall)), 0)
      rotate3d(1, .3, .2, var(--rot));
  }
}

@keyframes bbConfettiFade {
  0%   { opacity: 0; }
  1%   { opacity: 1; }
  78%  { opacity: 1; }
  100% { opacity: 0; }
}

.bb-confetti-toast {
  position: fixed;
  left: 50%;
  top: max(16px, 14vh);
  display: flex;
  align-items: center;
  gap: 10px;
  max-width: calc(100vw - 32px);
  padding: 12px 22px 12px 12px;
  border-radius: 999px;
  background: var(--bb-toast-bg, #5A2D05);
  color: #fff;
  font-family: inherit;
  font-size: 15px;
  font-weight: 700;
  line-height: 1.2;
  white-space: nowrap;
  box-shadow: 0 18px 50px rgba(0, 0, 0, .25), 0 0 0 4px rgba(255, 255, 255, .65);
  animation: bbToast 3.2s cubic-bezier(.2, .9, .25, 1.2) both;
}

.bb-confetti-toast__icon {
  width: 34px;
  height: 34px;
  flex: 0 0 auto;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, .16);
  font-size: 18px;
}

.bb-confetti-toast__text {
  overflow: hidden;
  text-overflow: ellipsis;
}

@keyframes bbToast {
  0%   { opacity: 0; transform: translate(-50%, -14px) scale(.85); }
  12%  { opacity: 1; transform: translate(-50%, 0) scale(1.04); }
  18%  { transform: translate(-50%, 0) scale(1); }
  82%  { opacity: 1; transform: translate(-50%, 0) scale(1); }
  100% { opacity: 0; transform: translate(-50%, -10px) scale(.96); }
}

@media (max-width: 749px) {
  .bb-confetti-toast {
    top: max(12px, 10vh);
    padding: 10px 16px 10px 10px;
    font-size: 13px;
  }

  .bb-confetti-toast__icon {
    width: 28px;
    height: 28px;
    font-size: 15px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .bb-confetti-toast {
    animation-name: bbToastFade;
  }

  @keyframes bbToastFade {
    0%, 100% { opacity: 0; transform: translate(-50%, 0); }
    10%, 85% { opacity: 1; transform: translate(-50%, 0); }
  }

  #BundleBuilder-{{ section.id }} .bb__cart-btn--celebrate,
  #BundleBuilder-{{ section.id }}.is-celebrating .bb__counter,
  #BundleBuilder-{{ section.id }}.is-complete .bb__progress-fill {
    animation: none;
  }
}


@media (min-width: 750px) {

  #BundleBuilder-{{ section.id }} .bb__status {
    grid-template-columns: 1fr auto;
    grid-template-areas:
      "pill counter"
      "msg msg";

    row-gap: 8px;

    padding: 12px 22px 10px;
  }

  #BundleBuilder-{{ section.id }} .bb__status-message {
    grid-area: msg;

    margin: 0;

    min-height: 24px;

    display: flex;
    align-items: center;

    font-size: 14px;
    line-height: 24px;

    white-space: nowrap;
    overflow: visible;
  }

  #BundleBuilder-{{ section.id }} .bb__progress {
    padding: 30px 22px 8px;
  }

}

</style>


<script>

(function () {

  'use strict';


  /* =======================================================
     ROOT
  ======================================================= */

  const root =
    document.getElementById(
      'BundleBuilder-{{ section.id }}'
    );

  if (!root) return;


  /* =======================================================
     SETTINGS
  ======================================================= */

  const MIN = Number(root.dataset.min);
  const MAX = Number(root.dataset.max);

  const CELEBRATE = root.dataset.celebrate === 'true';
  const CELEBRATE_TEXT = root.dataset.celebrateText || 'Bundle complete!';


  /* =======================================================
     STATE
  ======================================================= */

  const state = {
    items: {},
    totalQuantity: 0,
    subtotal: 0
  };


  /* =======================================================
     ELEMENTS
  ======================================================= */

  const products = root.querySelectorAll('.bb__product');
  const selectedContainer = root.querySelector('[data-selected]');
  const status = root.querySelector('[data-status]');
  const counter = root.querySelector('[data-counter]');
  const subtotal = root.querySelector('[data-subtotal]');
  const cartButton = root.querySelector('[data-add-cart]');
  const errorBox = root.querySelector('[data-error]');
  const progressFill = root.querySelector('[data-progress-fill]');


  /* =======================================================
     MONEY
  ======================================================= */

  function formatMoney(cents) {

    const amount = Number(cents || 0) / 100;

    return 'Rs. ' +
      amount.toLocaleString('en-IN', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      });

  }


  /* =======================================================
     GET PRODUCT DATA
  ======================================================= */

  function getProductData(card) {

    return {
      productId: card.dataset.productId,
      variantId: card.dataset.variantId,
      title: card.dataset.title,
      image: card.dataset.image,
      price: Number(card.dataset.price)
    };

  }


  /* =======================================================
     ADD / INCREASE
  ======================================================= */

  function increaseQuantity(variantId) {

    if (state.totalQuantity >= MAX) {
      return;
    }

    const card = root.querySelector(
      `.bb__product[data-variant-id="${variantId}"]`
    );

    if (!card) return;

    const product = getProductData(card);

    if (!state.items[variantId]) {

      state.items[variantId] = {
        ...product,
        quantity: 1
      };

    } else {

      state.items[variantId].quantity += 1;

    }

    updateState();

  }


  /* =======================================================
     REMOVE / DECREASE
  ======================================================= */

  function decreaseQuantity(variantId) {

    const item = state.items[variantId];

    if (!item) {
      return;
    }

    item.quantity -= 1;

    if (item.quantity <= 0) {
      delete state.items[variantId];
    }

    updateState();

  }


  /* =======================================================
     UPDATE STATE
  ======================================================= */

  function updateState() {

    const previousTotal = state.totalQuantity;

    let total = 0;
    let price = 0;

    Object.values(state.items).forEach(item => {
      total += item.quantity;
      price += item.price * item.quantity;
    });

    state.totalQuantity = total;
    state.subtotal = price;

    renderProductCards();
    renderBundleBar();

    /*
     * Celebrate only on (MAX - 1) → MAX, i.e. 19 → 20.
     * Dropping below and coming back triggers it again.
     */
    if (
      previousTotal === MAX - 1 &&
      state.totalQuantity === MAX
    ) {
      celebrate();
    }

  }


  /* =======================================================
     PRODUCT CARD RENDER
  ======================================================= */

  function renderProductCards() {

    products.forEach(card => {

      const variantId = card.dataset.variantId;
      const item = state.items[variantId];

      const quantity = card.querySelector('[data-quantity]');
      const increase = card.querySelector('[data-increase]');
      const decrease = card.querySelector('[data-decrease]');
      const addFirst = card.querySelector('[data-add-first]');
      const badge = card.querySelector('[data-badge]');

      /* Always show quantity. */
      quantity.textContent = item ? item.quantity : '0';

      /* Disable + at maximum. */
      increase.disabled = state.totalQuantity >= MAX;

      /* Disable - when quantity is zero. */
      decrease.disabled = !item || item.quantity <= 0;

      /* Desktop presentation helpers. */
      card.classList.toggle('is-selected', !!item);

      if (addFirst) {
        addFirst.disabled = state.totalQuantity >= MAX;
      }

      if (badge) {
        badge.textContent = item ? `× ${item.quantity}` : '';
      }

    });

  }


  /* =======================================================
     BUNDLE BAR
  ======================================================= */

  function renderBundleBar() {

    root.classList.toggle('is-min-met', state.totalQuantity >= MIN);
    root.classList.toggle('is-complete', state.totalQuantity >= MAX);

    if (progressFill) {
      const pct = MAX > 0
        ? Math.min(100, (state.totalQuantity / MAX) * 100)
        : 0;
      progressFill.style.width = pct + '%';
    }

    if (counter) {
      counter.textContent = `${state.totalQuantity} / ${MAX}`;
    }

    if (subtotal) {
      subtotal.textContent = formatMoney(state.subtotal);
    }


    /* ---------------------------------------
       STATUS
    ---------------------------------------- */

    let message;
    let canAdd;

    if (state.totalQuantity < MIN) {

      const remaining = MIN - state.totalQuantity;

      message = `Add ${remaining} more item${remaining === 1 ? '' : 's'}`;
      canAdd = false;

    } else if (state.totalQuantity < MAX) {

      const remaining = MAX - state.totalQuantity;

      message = `Minimum reached! Add up to ${remaining} more`;
      canAdd = true;

    } else {

      message = `Bundle full — ${MAX} items. Ready to add to cart!`;
      canAdd = true;

    }

    if (status) status.textContent = message;
    if (cartButton) cartButton.disabled = !canAdd;


    /* ---------------------------------------
       SELECTED PRODUCTS
    ---------------------------------------- */

    if (!selectedContainer) return;

    selectedContainer.innerHTML = '';

    Object.values(state.items).forEach(item => {

      for (let i = 0; i < item.quantity; i++) {

        const wrapper = document.createElement('div');
        wrapper.className = 'bb__selected-item';

        const img = document.createElement('img');
        img.src = item.image;
        img.alt = item.title;
        img.loading = 'lazy';

        const meta = document.createElement('div');
        meta.className = 'bb__selected-meta';

        const title = document.createElement('span');
        title.className = 'bb__selected-title';
        title.textContent = item.title;

        const itemPrice = document.createElement('span');
        itemPrice.className = 'bb__selected-price';
        itemPrice.textContent = formatMoney(item.price);

        meta.appendChild(title);
        meta.appendChild(itemPrice);

        const remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'bb__remove';
        remove.textContent = '−';
        remove.setAttribute('aria-label', `Remove one ${item.title}`);

        remove.addEventListener('click', function () {
          decreaseQuantity(item.variantId);
        });

        wrapper.appendChild(img);
        wrapper.appendChild(meta);
        wrapper.appendChild(remove);

        selectedContainer.appendChild(wrapper);

      }

    });


    /* ---------------------------------------
       EMPTY SLOTS
    ---------------------------------------- */

    const emptySlots = MAX - state.totalQuantity;

    for (let i = 0; i < emptySlots; i++) {

      const slotNumber = state.totalQuantity + i + 1;

      const empty = document.createElement('div');
      empty.className = 'bb__empty-slot';

      const icon = document.createElement('span');
      icon.className = 'bb__empty-icon';
      icon.textContent = '+';

      const meta = document.createElement('span');
      meta.className = 'bb__empty-meta';

      const strong = document.createElement('strong');
      strong.textContent = 'Select a product';

      const small = document.createElement('small');
      small.textContent =
        `Slot ${slotNumber} · ${slotNumber <= MIN ? 'Required' : 'Optional'}`;

      meta.appendChild(strong);
      meta.appendChild(small);

      empty.appendChild(icon);
      empty.appendChild(meta);

      selectedContainer.appendChild(empty);

    }

  }


  /* =======================================================
     CELEBRATION (pure CSS + JS confetti)
  ======================================================= */

  let celebrateTimer = null;
  let celebrateClassTimer = null;

  function rand(min, max) {
    return min + Math.random() * (max - min);
  }

  function pick(list) {
    return list[Math.floor(Math.random() * list.length)];
  }

  function makePiece(x, y, dx, dy, fall, palette, delayMax) {

    const piece = document.createElement('i');
    piece.className = 'bb-confetti-piece';

    const shape = Math.random();
    let w, h, r;

    if (shape < 0.45) {
      w = rand(7, 11); h = rand(4, 6); r = '2px';          // flake
    } else if (shape < 0.75) {
      w = rand(3, 4.5); h = rand(12, 18); r = '2px';       // ribbon
    } else {
      w = h = rand(6, 9); r = '50%';                       // dot
    }

    const spin = rand(360, 1080) * (Math.random() < 0.5 ? -1 : 1);

    piece.style.cssText =
      `--x:${x}px;--y:${y}px;` +
      `--dx:${dx.toFixed(1)}px;--dy:${dy.toFixed(1)}px;` +
      `--fall:${fall.toFixed(1)}px;--drift:${rand(-70, 70).toFixed(1)}px;` +
      `--rot:${spin.toFixed(0)}deg;` +
      `--dur:${rand(2200, 3300).toFixed(0)}ms;--delay:${rand(0, delayMax).toFixed(0)}ms;` +
      `--w:${w.toFixed(1)}px;--h:${h.toFixed(1)}px;--r:${r};--c:${pick(palette)};`;

    return piece;

  }

  function celebrate() {

    if (!CELEBRATE) return;

    const existing = document.querySelector(
      '.bb-confetti-layer[data-bb="{{ section.id }}"]'
    );
    if (existing) existing.remove();
    clearTimeout(celebrateTimer);

    const styles = getComputedStyle(root);
    const brown = styles.getPropertyValue('--bb-brown').trim() || '#5A2D05';
    const red = styles.getPropertyValue('--bb-red').trim() || '#A71920';
    const cream = styles.getPropertyValue('--bb-cream').trim() || '#FFF0D9';

    const palette = [brown, red, cream, '#F5A000', '#FFD36E', '#E07A2E', red, brown];

    const reduceMotion =
      window.matchMedia &&
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const vw = window.innerWidth;
    const vh = window.innerHeight;
    const isMobile = vw < 750;

    const layer = document.createElement('div');
    layer.className = 'bb-confetti-layer';
    layer.dataset.bb = '{{ section.id }}';
    layer.setAttribute('aria-hidden', 'true');
    layer.style.setProperty('--bb-toast-bg', brown);

    const frag = document.createDocumentFragment();

    if (!reduceMotion) {

      /* Two side cannons firing up and inward */
      const perCannon = isMobile ? 34 : 64;

      [{ x: 0, dir: 1 }, { x: vw, dir: -1 }].forEach(cannon => {

        for (let i = 0; i < perCannon; i++) {

          const angle = rand(50, 82) * Math.PI / 180;
          const velocity = vh * rand(0.55, 1.05);

          const dx = Math.cos(angle) * velocity * cannon.dir;
          const dy = -Math.sin(angle) * velocity;

          frag.appendChild(
            makePiece(cannon.x, vh + 10, dx, dy, vh * rand(0.35, 0.7), palette, 220)
          );

        }

      });

      /* Radial pop from the counter */
      if (counter) {

        const rect = counter.getBoundingClientRect();
        const cx = rect.left + rect.width / 2;
        const cy = rect.top + rect.height / 2;
        const burst = isMobile ? 22 : 38;

        for (let i = 0; i < burst; i++) {

          const angle = rand(0, Math.PI * 2);
          const velocity = rand(70, isMobile ? 160 : 230);

          frag.appendChild(
            makePiece(
              cx, cy,
              Math.cos(angle) * velocity,
              Math.sin(angle) * velocity - 50,
              rand(180, 380),
              palette,
              80
            )
          );

        }

      }

    }

    /* Toast */
    const toast = document.createElement('div');
    toast.className = 'bb-confetti-toast';

    const toastIcon = document.createElement('span');
    toastIcon.className = 'bb-confetti-toast__icon';
    toastIcon.textContent = '🎉';

    const toastText = document.createElement('span');
    toastText.className = 'bb-confetti-toast__text';
    toastText.textContent = CELEBRATE_TEXT;

    toast.appendChild(toastIcon);
    toast.appendChild(toastText);
    frag.appendChild(toast);

    layer.appendChild(frag);
    document.body.appendChild(layer);

    /* Pulse cart button + pop counter */
    if (cartButton) {
      cartButton.classList.remove('bb__cart-btn--celebrate');
      void cartButton.offsetWidth;
      cartButton.classList.add('bb__cart-btn--celebrate');
    }

    root.classList.remove('is-celebrating');
    void root.offsetWidth;
    root.classList.add('is-celebrating');

    clearTimeout(celebrateClassTimer);
    celebrateClassTimer = setTimeout(function () {
      root.classList.remove('is-celebrating');
      if (cartButton) cartButton.classList.remove('bb__cart-btn--celebrate');
    }, 2100);

    celebrateTimer = setTimeout(function () {
      layer.remove();
    }, 4000);

  }




  /* =======================================================
     PRODUCT DETAILS MODAL
  ======================================================= */

  const productModal = root.querySelector('[data-product-modal]');
  const modalImage = root.querySelector('[data-modal-image]');
  const modalTitle = root.querySelector('[data-modal-title]');
  const modalPrice = root.querySelector('[data-modal-price]');
  const modalDescription = root.querySelector('[data-modal-description]');
  const modalFooterPrice = root.querySelector('[data-modal-footer-price]');
  const modalAdd = root.querySelector('[data-modal-add]');
  let activeModalVariantId = null;

  function escapeHtml(value) {
    return String(value || '').replace(/[&<>'"]/g, function (char) {
      return {
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        "'": '&#39;',
        '"': '&quot;'
      }[char];
    });
  }

  function openProductModal(card) {
    if (!productModal) return;

    activeModalVariantId = card.dataset.variantId;

    const title = card.dataset.title || '';
    const image = card.dataset.image || '';
    const price = Number(card.dataset.price || 0);
    const comparePrice = Number(card.dataset.comparePrice || 0);
    const description = card.dataset.description || 'Product details coming soon.';

    modalTitle.textContent = title;
    modalImage.src = image;
    modalImage.alt = title;
    modalPrice.innerHTML = formatMoney(price) +
      (comparePrice > price
        ? '<span class="bb-product-modal__compare">' + formatMoney(comparePrice) + '</span>'
        : '');
    modalFooterPrice.textContent = formatMoney(price);
    modalDescription.textContent = description;

    modalAdd.disabled = state.totalQuantity >= MAX;
    modalAdd.textContent = state.totalQuantity >= MAX ? 'BUNDLE FULL' : 'ADD TO BOX';

    productModal.hidden = false;
    productModal.setAttribute('aria-hidden', 'false');
    document.body.classList.add('bb-modal-open');
  }

  function closeProductModal() {
    if (!productModal) return;

    productModal.hidden = true;
    productModal.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('bb-modal-open');
    activeModalVariantId = null;
  }

  if (productModal) {
    productModal.querySelectorAll('[data-modal-close]').forEach(function (element) {
      element.addEventListener('click', closeProductModal);
    });

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && !productModal.hidden) {
        closeProductModal();
      }
    });

    if (modalAdd) {
      modalAdd.addEventListener('click', function () {
        if (!activeModalVariantId || state.totalQuantity >= MAX) return;

        increaseQuantity(activeModalVariantId);
        modalAdd.disabled = state.totalQuantity >= MAX;
        modalAdd.textContent = state.totalQuantity >= MAX ? 'BUNDLE FULL' : 'ADD TO BOX';
      });
    }
  }

  /* =======================================================
     PRODUCT EVENTS
  ======================================================= */

  products.forEach(card => {

    const variantId = card.dataset.variantId;

    const increase = card.querySelector('[data-increase]');
    const decrease = card.querySelector('[data-decrease]');
    const addFirst = card.querySelector('[data-add-first]');

    increase.addEventListener('click', function () {
      increaseQuantity(variantId);
    });

    decrease.addEventListener('click', function () {
      decreaseQuantity(variantId);
    });

    if (addFirst) {
      addFirst.addEventListener('click', function () {
        increaseQuantity(variantId);
      });
    }

    card.addEventListener('click', function (event) {
      if (event.target.closest('button, input, select, textarea, a')) {
        return;
      }

      openProductModal(card);
    });

  });


  /* =======================================================
     ADD BUNDLE TO SHOPIFY CART
  ======================================================= */

  if (cartButton) {

    cartButton.addEventListener('click', async function () {

      if (
        state.totalQuantity < MIN ||
        state.totalQuantity > MAX
      ) {
        return;
      }

      cartButton.disabled = true;

      const originalText = cartButton.textContent;

      cartButton.textContent = 'Adding...';

      if (errorBox) errorBox.hidden = true;

      const items = Object.values(state.items).map(item => ({
        id: Number(item.variantId),
        quantity: Number(item.quantity)
      }));

      try {

        const response = await fetch(
          window.Shopify.routes.root + 'cart/add.js',
          {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify({ items: items })
          }
        );

        if (!response.ok) {

          let message = 'Unable to add bundle to cart.';

          try {
            const error = await response.json();
            message = error.description || message;
          } catch (e) {}

          throw new Error(message);

        }

        await response.json();

        /*
         * Rebuy Smart Cart
         * If Rebuy exists, open it. Otherwise go to normal cart.
         */

        if (
          window.Rebuy &&
          window.Rebuy.SmartCart &&
          typeof window.Rebuy.SmartCart.show === 'function'
        ) {

          /* Give Shopify a moment to update the cart before opening Rebuy. */
          setTimeout(function () {
            window.Rebuy.SmartCart.show();
          }, 300);

        } else {

          /* Fallback. */
          window.location.href = window.Shopify.routes.root + 'cart';

        }

      } catch (error) {

        console.error('Bundle cart error:', error);

        if (errorBox) {
          errorBox.textContent =
            error.message || 'Something went wrong. Please try again.';
          errorBox.hidden = false;
        }

        cartButton.disabled = false;
        cartButton.textContent = originalText;

      }

    });

  }


  /* =======================================================
     INITIAL STATE
  ======================================================= */

  updateState();


})();

</script>


