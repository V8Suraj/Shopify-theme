{% liquid
  assign bundle_collection = section.settings.collection
  assign min_items = section.settings.min_items
  assign max_items = section.settings.max_items

  assign min_pct = min_items | times: 100.0 | divided_by: max_items
  if min_pct > 100
    assign min_pct = 100
  endif
%}

<section
  id="BundleBuilder-{{ section.id }}"
  class="bb"
  data-section-id="{{ section.id }}"
  data-min="{{ min_items }}"
  data-max="{{ max_items }}"
  data-celebrate="{{ section.settings.enable_celebration }}"
  data-celebrate-text="{{ section.settings.celebration_text | escape }}"
  style="--bb-sidebar-top: {{ section.settings.sidebar_offset }}px;"
>

  <div class="bb__container">

    <!-- =========================================
         HERO
    ========================================== -->

    <div class="bb__hero">

      <div class="bb__eyebrow">
        {{ section.settings.eyebrow }}
      </div>

      <h1 class="bb__hero-title">
        {{ section.settings.heading }}
      </h1>

      <div class="bb__limit">
        {{ section.settings.limit_text }}
      </div>

    </div>


    <!-- =========================================
         LAYOUT (desktop: products + sidebar)
    ========================================== -->

    <div class="bb__layout{% unless section.settings.enable_sticky %} bb__layout--full{% endunless %}">

      <div class="bb__main">

        <!-- COLLECTION HEADER -->

        <div class="bb__collection-header">

          <div class="bb__collection-heading">

            <h2>
              Get started here
            </h2>

            <p>
              Choose from this collection of products
            </p>

          </div>


          <button
            type="button"
            class="bb__top-btn"
            aria-label="Scroll to top"
            onclick="document.getElementById('BundleBuilder-{{ section.id }}').scrollIntoView({behavior:'smooth'})"
          >
            <span>⌃</span>
            <small>Top</small>
          </button>

        </div>


        <!-- PRODUCT GRID -->

        {% if bundle_collection != blank %}

          <div class="bb__grid">

            {% for product in bundle_collection.products limit: 50 %}

              {% assign variant = product.selected_or_first_available_variant %}

              <article
                class="bb__product"
                data-product-id="{{ product.id }}"
                data-variant-id="{{ variant.id }}"
                data-title="{{ product.title | escape }}"
                data-image="{% if product.featured_image %}{{ product.featured_image | image_url: width: 600 }}{% endif %}"
                data-price="{{ variant.price }}"
                data-compare-price="{{ variant.compare_at_price | default: 0 }}"
                data-description="{{ product.description | strip_html | escape }}"
              >

                <!-- IMAGE -->

                <div class="bb__image-wrap">

                  {% if product.featured_image %}

                    {{
                      product.featured_image
                      | image_url: width: 700
                      | image_tag:
                        loading: 'lazy',
                        class: 'bb__image',
                        alt: product.featured_image.alt | default: product.title
                    }}

                  {% else %}

                    <div class="bb__no-image">
                      No image
                    </div>

                  {% endif %}

                  <span class="bb__badge" data-badge aria-hidden="true"></span>

                </div>


                <!-- PRODUCT CONTENT -->

                <div class="bb__product-content">

                  <!-- TITLE -->

                  <h3 class="bb__product-title">
                    {{ product.title }}
                  </h3>


                  <!-- VARIANT (desktop only) -->

                  <div class="bb__variant">
                    {% unless product.has_only_default_variant %}{{ variant.title }}{% endunless %}
                  </div>


                  <!-- RATING -->

                  {% if section.settings.show_reviews %}

                    <div class="bb__rating">

                      <span class="bb__stars">
                        ★★★★★
                      </span>

                      {% assign review_count = product.metafields.reviews.rating_count.value %}

                      {% if review_count != blank %}

                        <span class="bb__reviews">
                          ({{ review_count }} Reviews)
                        </span>

                      {% else %}

                        <span class="bb__reviews">
                          (0 Reviews)
                        </span>

                      {% endif %}

                    </div>

                  {% else %}

                    <div class="bb__rating bb__rating--empty"></div>

                  {% endif %}


                  <!-- PRICE -->

                  <div class="bb__price">

                    <span class="bb__current-price">
                      {{ variant.price | money }}
                    </span>

                    {% if section.settings.show_compare_price
                      and variant.compare_at_price > variant.price
                    %}

                      <span class="bb__compare-price">
                        {{ variant.compare_at_price | money }}
                      </span>

                    {% endif %}

                  </div>


                  <!-- ACTION -->

                  <div class="bb__action">

                    <!-- Desktop: shown while quantity is 0 -->
                    <button
                      type="button"
                      class="bb__add-first"
                      data-add-first
                      aria-label="Add {{ product.title | escape }} to bundle"
                    >
                      Add to Bundle
                    </button>

                    <div
                      class="bb__quantity"
                      data-quantity-controls
                    >

                      <button
                        type="button"
                        class="bb__qty-btn"
                        data-decrease
                        aria-label="Decrease {{ product.title | escape }} quantity"
                      >
                        −
                      </button>


                      <span
                        class="bb__qty-value"
                        data-quantity
                      >
                        0
                      </span>


                      <button
                        type="button"
                        class="bb__qty-btn"
                        data-increase
                        aria-label="Increase {{ product.title | escape }} quantity"
                      >
                        +
                      </button>

                    </div>

                  </div>

                </div>

              </article>

            {% endfor %}

          </div>

        {% else %}

          <div class="bb__empty">
            Please select a collection from the Theme Editor.
          </div>

        {% endif %}

      </div>


      <!-- =========================================
           BUNDLE BAR
           Desktop: sticky sidebar
           Mobile: fixed bottom bar
      ========================================== -->

      {% if section.settings.enable_sticky %}

        <aside class="bb__sticky" aria-label="Your bundle">

          <div class="bb__sticky-inner">

            <!-- SIDEBAR HEAD (desktop only) -->

            <div class="bb__sidebar-head">
              <h3>Your Bundle</h3>
              <span>{{ min_items }}–{{ max_items }} items</span>
            </div>


            <!-- STATUS ROW -->

            <div class="bb__status">

              <div class="bb__status-pill">
                MIN {{ min_items }} • MAX {{ max_items }}
              </div>


              <div
                class="bb__status-message"
                data-status
                aria-live="polite"
              >
                Add {{ min_items }} more items
              </div>


              <div
                class="bb__counter"
                data-counter
              >
                0 / {{ max_items }}
              </div>

            </div>


            <!-- PROGRESS (desktop only) -->

            <div class="bb__progress" aria-hidden="true">

              <div class="bb__progress-track">
                <div class="bb__progress-fill" data-progress-fill></div>
                <span class="bb__progress-marker" style="left: {{ min_pct }}%;"></span>
              </div>

              <div class="bb__progress-labels">
                <span>0</span>
                <span class="bb__progress-min" style="left: {{ min_pct }}%;">Min {{ min_items }}</span>
                <span>Max {{ max_items }}</span>
              </div>

            </div>


            <!-- SELECTED PRODUCTS -->

            <div class="bb__selected-area">

              <div
                class="bb__selected"
                data-selected
              >
              </div>

            </div>


            <!-- FOOTER -->

            <div class="bb__sticky-footer">

              <div class="bb__subtotal">

                <span>
                  Subtotal
                </span>

                <strong data-subtotal>
                  {{ 0 | money }}
                </strong>

              </div>


              <button
                type="button"
                class="bb__cart-btn"
                data-add-cart
                disabled
              >
                {{ section.settings.cart_button_text }}
              </button>

            </div>


            <div
              class="bb__error"
              data-error
              hidden
            ></div>

          </div>

        </aside>

      {% endif %}

    </div>

  </div>

<!-- PRODUCT DETAILS MODAL -->
<div class="bb-product-modal" data-product-modal hidden aria-hidden="true">
  <div class="bb-product-modal__overlay" data-modal-close></div>
  <div class="bb-product-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="bb-modal-title-{{ section.id }}">
    <button type="button" class="bb-product-modal__close" data-modal-close aria-label="Close product details">×</button>

    <div class="bb-product-modal__media">
      <img data-modal-image alt="" loading="lazy">
    </div>

    <div class="bb-product-modal__content">
      <div class="bb-product-modal__top">
        <h2 id="bb-modal-title-{{ section.id }}" data-modal-title></h2>
        <div class="bb-product-modal__price" data-modal-price></div>
      </div>

      <div class="bb-product-modal__divider"></div>

      <div class="bb-product-modal__description" data-modal-description></div>

      <div class="bb-product-modal__footer">
        <div class="bb-product-modal__footer-price" data-modal-footer-price></div>
        <button type="button" class="bb-product-modal__add" data-modal-add>ADD TO BOX</button>
      </div>
    </div>
  </div>
</div>

</section>


<style>

/* =========================================================
   ROOT
========================================================= */

#BundleBuilder-{{ section.id }} {

  --bb-brown: {{ section.settings.brown_color }};
  --bb-cream: {{ section.settings.cream_color }};
  --bb-red: {{ section.settings.red_color }};

  --bb-white: #ffffff;
  --bb-border: #5A2D05;
  --bb-light-border: #ded8d0;
  --bb-soft-border: #ece4da;
  --bb-muted: #8a7a6a;
  --bb-gold: #F5A000;

  width: 100%;
  margin: 0;
  padding: 0;
  color: var(--bb-brown);
  box-sizing: border-box;
  overflow: visible;
}

#BundleBuilder-{{ section.id }} *,
#BundleBuilder-{{ section.id }} *::before,
#BundleBuilder-{{ section.id }} *::after {
  box-sizing: border-box;
}


/* =========================================================
   BASE (mobile foundation — unchanged look)
========================================================= */

#BundleBuilder-{{ section.id }} .bb__container {
  width: min(1200px, calc(100% - 32px));
  margin: 0 auto;
  padding-bottom: 30px;
}

#BundleBuilder-{{ section.id }} .bb__layout {
  display: block;
}

#BundleBuilder-{{ section.id }} .bb__main {
  min-width: 0;
}


/* HERO */

#BundleBuilder-{{ section.id }} .bb__hero {
  width: min(825px, 100%);
  margin: 0 auto 68px;
  padding: 28px 24px 25px;
  background: var(--bb-cream);
  border: 2px solid var(--bb-brown);
  border-radius: 28px;
  box-shadow: 8px 8px 0 var(--bb-brown);
  text-align: center;
}

#BundleBuilder-{{ section.id }} .bb__eyebrow {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 78px;
  padding: 0 30px;
  margin-bottom: 8px;
  border-radius: 50px;
  background: var(--bb-red);
  color: #ffffff;
  font-size: 14px;
  font-weight: 700;
  letter-spacing: .3px;
}

#BundleBuilder-{{ section.id }} .bb__hero-title {
  margin: 0;
  color: var(--bb-brown);
  font-size: clamp(30px, 4vw, 42px);
  line-height: 1.1;
  font-weight: 700;
  text-transform: uppercase;
}

#BundleBuilder-{{ section.id }} .bb__limit {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 26px;
  min-height: 43px;
  padding: 8px 24px;
  border: 2px dashed var(--bb-brown);
  border-radius: 40px;
  background: #ffffff;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: .5px;
}


/* COLLECTION HEADER */

#BundleBuilder-{{ section.id }} .bb__collection-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 10px;
  margin-bottom: 18px;
}

#BundleBuilder-{{ section.id }} .bb__collection-heading {
  min-width: 0;
}

#BundleBuilder-{{ section.id }} .bb__collection-header h2 {
  margin: 0;
  font-size: 18px;
  line-height: 1.2;
  font-weight: 700;
}

#BundleBuilder-{{ section.id }} .bb__collection-header p {
  margin: 5px 0 0;
  font-size: 15px;
  line-height: 1.3;
}

#BundleBuilder-{{ section.id }} .bb__top-btn {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1px;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--bb-brown);
  cursor: pointer;
}

#BundleBuilder-{{ section.id }} .bb__top-btn span {
  display: block;
  font-size: 28px;
  line-height: 18px;
}

#BundleBuilder-{{ section.id }} .bb__top-btn small {
  font-size: 11px;
  line-height: 1;
}


/* PRODUCT GRID */

#BundleBuilder-{{ section.id }} .bb__grid {
  display: grid;
  grid-template-columns: repeat({{ section.settings.desktop_columns }}, minmax(0, 1fr));
  gap: 18px;
  align-items: stretch;
  margin-bottom: 0;
  padding-bottom: 0;
}


/* PRODUCT CARD */

#BundleBuilder-{{ section.id }} .bb__product {
  min-width: 0;
  width: 100%;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background: #ffffff;
  border: 2px solid var(--bb-brown);
  border-radius: 20px;
}

#BundleBuilder-{{ section.id }} .bb__image-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: 1 / 1;
  flex: 0 0 auto;
  overflow: hidden;
  background: #f7f1e8;
}

#BundleBuilder-{{ section.id }} .bb__image {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

#BundleBuilder-{{ section.id }} .bb__no-image {
  width: 100%;
  height: 100%;
  display: grid;
  place-items: center;
  color: #777;
  font-size: 13px;
}

#BundleBuilder-{{ section.id }} .bb__badge {
  display: none;
}

#BundleBuilder-{{ section.id }} .bb__product-content {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 13px;
}

#BundleBuilder-{{ section.id }} .bb__product-title {
  width: 100%;
  height: 42px;
  min-height: 42px;
  margin: 0;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  color: var(--bb-brown);
  font-size: 15px;
  line-height: 21px;
  font-weight: 700;
}

#BundleBuilder-{{ section.id }} .bb__variant {
  display: none;
}

#BundleBuilder-{{ section.id }} .bb__rating {
  width: 100%;
  height: 24px;
  min-height: 24px;
  margin-top: 6px;
  display: flex;
  align-items: center;
  gap: 6px;
  overflow: hidden;
}

#BundleBuilder-{{ section.id }} .bb__rating--empty {
  visibility: hidden;
}

#BundleBuilder-{{ section.id }} .bb__stars {
  flex: 0 0 auto;
  color: #f5a000;
  font-size: 16px;
  line-height: 1;
  letter-spacing: -2px;
  white-space: nowrap;
}

#BundleBuilder-{{ section.id }} .bb__reviews {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #555555;
  font-size: 11px;
  line-height: 1;
}

#BundleBuilder-{{ section.id }} .bb__price {
  width: 100%;
  height: 29px;
  min-height: 29px;
  margin: 4px 0 9px;
  display: flex;
  align-items: center;
  gap: 7px;
  overflow: hidden;
}

#BundleBuilder-{{ section.id }} .bb__current-price {
  flex: 0 0 auto;
  color: var(--bb-brown);
  font-size: 14px;
  line-height: 1;
  font-weight: 700;
}

#BundleBuilder-{{ section.id }} .bb__compare-price {
  flex: 0 0 auto;
  color: #777777;
  font-size: 12px;
  line-height: 1;
  text-decoration: line-through;
}


/* QUANTITY */

#BundleBuilder-{{ section.id }} .bb__action {
  width: 100%;
  height: 44px;
  min-height: 44px;
  margin-top: auto;
}

#BundleBuilder-{{ section.id }} .bb__add-first {
  display: none;
}

#BundleBuilder-{{ section.id }} .bb__quantity {
  width: 100%;
  height: 44px;
  min-height: 44px;
  display: grid;
  grid-template-columns: 44px minmax(0, 1fr) 44px;
  align-items: center;
  overflow: hidden;
  border: 1px solid #d8d3cd;
  border-radius: 30px;
  background: #ffffff;
}

#BundleBuilder-{{ section.id }} .bb__qty-btn {
  width: 44px;
  height: 44px;
  display: grid;
  place-items: center;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--bb-brown);
  font-size: 20px;
  line-height: 1;
  cursor: pointer;
}

#BundleBuilder-{{ section.id }} .bb__qty-btn:hover {
  background: #f8f4ef;
}

#BundleBuilder-{{ section.id }} .bb__qty-btn:disabled {
  opacity: .35;
  cursor: not-allowed;
}

#BundleBuilder-{{ section.id }} .bb__qty-value {
  display: grid;
  place-items: center;
  height: 100%;
  color: var(--bb-brown);
  font-size: 14px;
  font-weight: 700;
}


/* STICKY BAR */

#BundleBuilder-{{ section.id }} .bb__sticky {
  position: fixed;
  left: 50%;
  bottom: 8px;
  transform: translateX(-50%);
  width: min(1180px, calc(100% - 40px));
  overflow: hidden;
  background: #ffffff;
  border: 1px solid #dedede;
  border-radius: 18px;
  box-shadow: 0 5px 25px rgba(0,0,0,.15);
  z-index: 1000;
}

#BundleBuilder-{{ section.id }} .bb__sticky-inner {
  width: 100%;
}

#BundleBuilder-{{ section.id }} .bb__sidebar-head,
#BundleBuilder-{{ section.id }} .bb__progress {
  display: none;
}

#BundleBuilder-{{ section.id }} .bb__status {
  min-height: 47px;
  display: grid;
  grid-template-columns: 1fr 2fr 1fr;
  align-items: center;
  gap: 15px;
  padding: 8px 16px;
  background: #f7f5f1;
  border-bottom: 2px solid var(--bb-brown);
}

#BundleBuilder-{{ section.id }} .bb__status-pill {
  justify-self: start;
  padding: 6px 11px;
  border-radius: 20px;
  background: #fff0d9;
  color: var(--bb-brown);
  font-size: 11px;
  line-height: 1;
  font-weight: 700;
  white-space: nowrap;
}

#BundleBuilder-{{ section.id }} .bb__status-message {
  min-width: 0;
  overflow: hidden;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #333333;
  font-size: 14px;
  line-height: 1.2;
  font-weight: 700;
  padding-bottom:10px;
}

#BundleBuilder-{{ section.id }} .bb__counter {
  justify-self: end;
  color: #333333;
  font-size: 13px;
  line-height: 1;
  font-weight: 700;
}

#BundleBuilder-{{ section.id }} .bb__selected-area {
  width: 100%;
  padding: 12px 16px 9px;
  overflow: hidden;
}

#BundleBuilder-{{ section.id }} .bb__selected {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 8px;
  overflow-x: auto;
  overflow-y: hidden;
  padding: 0 3px 3px;
  scrollbar-width: thin;
}

#BundleBuilder-{{ section.id }} .bb__selected::-webkit-scrollbar {
  height: 5px;
}

#BundleBuilder-{{ section.id }} .bb__selected::-webkit-scrollbar-thumb {
  background: #999999;
  border-radius: 10px;
}

#BundleBuilder-{{ section.id }} .bb__selected-item {
  position: relative;
  flex: 0 0 70px;
  width: 70px;
  height: 70px;
  border: 1px solid #dddddd;
  border-radius: 12px;
  background: #f8f3eb;
}

#BundleBuilder-{{ section.id }} .bb__selected-item img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 11px;
}

#BundleBuilder-{{ section.id }} .bb__selected-meta,
#BundleBuilder-{{ section.id }} .bb__empty-meta {
  display: none;
}

#BundleBuilder-{{ section.id }} .bb__remove {
  position: absolute;
  top: -7px;
  right: -5px;
  z-index: 3;
  width: 21px;
  height: 21px;
  display: grid;
  place-items: center;
  padding: 0;
  border: 0;
  border-radius: 5px;
  background: #000000;
  color: #ffffff;
  font-size: 14px;
  line-height: 1;
  cursor: pointer;
}

#BundleBuilder-{{ section.id }} .bb__empty-slot {
  flex: 0 0 70px;
  width: 70px;
  height: 70px;
  display: grid;
  place-items: center;
  border: 1px solid #dddddd;
  border-radius: 12px;
  background: #fafafa;
  color: #999999;
  font-size: 28px;
}

#BundleBuilder-{{ section.id }} .bb__sticky-footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 20px;
  padding: 8px 16px 14px;
}

#BundleBuilder-{{ section.id }} .bb__subtotal {
  min-width: 130px;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

#BundleBuilder-{{ section.id }} .bb__subtotal span {
  color: #666666;
  font-size: 12px;
  line-height: 1.2;
}

#BundleBuilder-{{ section.id }} .bb__subtotal strong {
  color: var(--bb-brown);
  font-size: 18px;
  line-height: 1.2;
}

#BundleBuilder-{{ section.id }} .bb__cart-btn {
  width: 230px;
  min-height: 48px;
  border: 0;
  border-radius: 30px;
  background: var(--bb-brown);
  color: #ffffff;
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
}

#BundleBuilder-{{ section.id }} .bb__cart-btn:hover {
  opacity: .9;
}

#BundleBuilder-{{ section.id }} .bb__cart-btn:disabled {
  opacity: .4;
  cursor: not-allowed;
}

#BundleBuilder-{{ section.id }} .bb__cart-btn--celebrate {
  animation: bbCartPulse 1s ease-out 2;
}

#BundleBuilder-{{ section.id }}.is-celebrating .bb__counter {
  animation: bbPop .6s cubic-bezier(.2, 1.6, .4, 1);
}

#BundleBuilder-{{ section.id }} .bb__error {
  padding: 8px 16px;
  background: #fff1f0;
  color: #b42318;
  text-align: center;
  font-size: 12px;
}

#BundleBuilder-{{ section.id }} .bb__empty {
  padding: 40px;
  border: 2px dashed var(--bb-brown);
  border-radius: 15px;
  text-align: center;
}


/* =========================================================
   MOBILE (unchanged)
========================================================= */

@media (max-width: 749px) {

  #BundleBuilder-{{ section.id }} .bb__container {
    width: calc(100% - 20px);
    padding-bottom: 30px;
  }

  #BundleBuilder-{{ section.id }} .bb__hero {
    margin-bottom: 52px;
    margin-top: 30px;
    padding: 18px 24px;
    border-radius: 22px;
    box-shadow: 6px 6px 0 var(--bb-brown);
  }

  #BundleBuilder-{{ section.id }} .bb__eyebrow {
    min-height: 50px;
    padding: 0 18px;
    font-size: 11px;
  }

  #BundleBuilder-{{ section.id }} .bb__hero-title {
    font-size: 28px;
  }

  #BundleBuilder-{{ section.id }} .bb__limit {
    min-height: 38px;
    margin-top: 18px;
    padding: 7px 15px;
    font-size: 10px;
  }

  #BundleBuilder-{{ section.id }} .bb__collection-header {
    padding: 0 5px;
    margin-bottom: 12px;
