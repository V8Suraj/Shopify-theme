<div class="container-full logo-marquee">

  <div class="logo-marquee-inner">

    <div class="logo-heading">
      {{ section.settings.marquee_heading }}
    </div>

    <div class="main-wrapper">

      <div class="marquee-track">

        <!-- FIRST SET -->
        <div class="logo-set">

          {% for block in section.blocks %}

            {% if block.settings.partner_icon != blank %}

              <div class="img">

                {{ block.settings.partner_icon
                  | image_url: width: 300
                  | image_tag:
                    loading: 'lazy',
                    widths: '150, 200, 300'
                }}

              </div>

            {% endif %}

          {% endfor %}

        </div>


        <!-- DUPLICATE SET -->
        <div class="logo-set" aria-hidden="true">

          {% for block in section.blocks %}

            {% if block.settings.partner_icon != blank %}

              <div class="img">

                {{ block.settings.partner_icon
                  | image_url: width: 300
                  | image_tag:
                    loading: 'lazy',
                    widths: '150, 200, 300'
                }}

              </div>

            {% endif %}

          {% endfor %}

        </div>

      </div>

    </div>

  </div>

</div>


<style>

  /* =========================================
     HEADING
  ========================================= */

  .logo-heading {
    font-family: "Rubik", sans-serif;
    font-weight: 500;
    font-size: 32px;
    line-height: 120%;
    letter-spacing: 0;
    text-transform: uppercase;
    color: #910606;

    max-width: 280px;
    width: 100%;
    flex-shrink: 0;
  }


  /* =========================================
     SECTION
  ========================================= */

  .partner-section {
    padding: 50px 80px;

    {% if section.settings.bg_image != blank %}
      background-image: url({{ section.settings.bg_image | image_url }});
    {% endif %}

    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }


  /* =========================================
     INNER
  ========================================= */

  .logo-marquee-inner {
    display: flex;
    align-items: center;
    gap: 40px;
  }


  /* =========================================
     MAIN VIEWPORT
  ========================================= */

  .partner-section .main-wrapper {
    position: relative;

    flex: 1;
    min-width: 0;

    overflow: hidden;
  }


  /* =========================================
     LEFT FADE
  ========================================= */

  .partner-section .main-wrapper::before {
    content: "";

    position: absolute;

    top: 0;
    left: 0;

    width: 120px;
    height: 100%;

    background: linear-gradient(
      90deg,
      #FFEED7 0%,
      rgba(255, 238, 215, 0) 100%
    );

    z-index: 2;

    pointer-events: none;
  }


  /* =========================================
     RIGHT FADE
  ========================================= */

  .partner-section .main-wrapper::after {
    content: "";

    position: absolute;

    top: 0;
    right: 0;

    width: 120px;
    height: 100%;

    background: linear-gradient(
      270deg,
      #FFEED7 0%,
      rgba(255, 238, 215, 0) 100%
    );

    z-index: 2;

    pointer-events: none;
  }


  /* =========================================
     TRACK
  ========================================= */

  .marquee-track {
    display: flex;
    align-items: center;

    width: max-content;

    flex-shrink: 0;

    animation: logoMarquee 20s linear infinite;

    will-change: transform;
  }


  /* =========================================
     EACH LOGO SET
  ========================================= */

  .logo-set {
    display: flex;
    align-items: center;

    flex-shrink: 0;

    gap: 24px;

    padding-right: 24px;
  }


  /* =========================================
     LOGO
  ========================================= */

  .logo-set .img {
    display: flex;
    align-items: center;
    justify-content: center;

    flex-shrink: 0;
  }


  .partner-section .img img {
    display: block;

    height: 84px;
    width: auto;

    max-width: none;
  }


  /* =========================================
     DESKTOP ANIMATION
  ========================================= */

  @keyframes logoMarquee {

    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-50%);
    }

  }


  /* =========================================
     TABLET
  ========================================= */

  @media (max-width: 1551px) {

    .partner-section {
      padding: 40px;
    }


    .logo-marquee-inner {
      gap: 30px;
    }


    .logo-heading {
      font-size: 28px;
      max-width: 240px;
    }


    .partner-section .img img {
      height: 60px;
    }


    .logo-set {
      gap: 18px;
      padding-right: 18px;
    }


    .partner-section .main-wrapper::before,
    .partner-section .main-wrapper::after {
      width: 80px;
    }

  }


  /* =========================================
     MOBILE
  ========================================= */

  @media (max-width: 768px) {

    .partner-section {
      padding: 20px;
    }


    .logo-marquee-inner {
      flex-direction: column;

      text-align: center;

      gap: 16px;

      align-items: stretch;
    }


    .logo-heading {
      font-size: 24px;

      max-width: 100%;
    }


    .partner-section .main-wrapper {
      width: 100%;
    }


    .partner-section .main-wrapper::before,
    .partner-section .main-wrapper::after {
      width: 30px;
    }


    .marquee-track {
      animation-duration: 18s;
    }


    .logo-set {
      gap: 12px;
      padding-right: 12px;
    }


    .partner-section .img img {
      height: 60px;
    }

  }


  /* =========================================
     REDUCED MOTION
  ========================================= */

  @media (prefers-reduced-motion: reduce) {

    .marquee-track {
      animation: none;
    }

  }

</style>


{% schema %}

{
  "name": "Logo marquee",

  "tag": "section",

  "class": "partner-section",

  "settings": [

    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },

    {
      "type": "text",
      "id": "marquee_heading",
      "label": "Heading",
      "default": "Every Batch is Certified."
    }

  ],

  "blocks": [

    {
      "type": "logo",

      "name": "Logo",

      "settings": [

        {
          "type": "image_picker",
          "id": "partner_icon",
          "label": "Logo"
        }

      ]

    }

  ],

  "presets": [

    {
      "name": "Logo marquee"
    }

  ]

}

{% endschema %}