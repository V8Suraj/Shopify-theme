<section class="also-available-section">

  <div class="available-container">

    {% if section.settings.heading != blank %}
      <h2 class="available-heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p class="available-subheading">
        {{ section.settings.subheading }}
      </p>
    {% endif %}

    <div class="available-logos-wrapper">

      <div class="available-logos">

        {% comment %}
          FIRST SET OF LOGOS
        {% endcomment %}

        {% for block in section.blocks %}
          <a
            href="{{ block.settings.link }}"
            class="logo-item"
            target="_blank"
            rel="noopener noreferrer"
            {{ block.shopify_attributes }}
          >
            {% if block.settings.logo %}
              <img
                src="{{ block.settings.logo | image_url: width: 800 }}"
                alt="{{ block.settings.logo.alt | escape }}"
                width="{{ block.settings.logo.width }}"
                height="{{ block.settings.logo.height }}"
                loading="lazy"
              >
            {% endif %}
          </a>
        {% endfor %}


        {% comment %}
          DUPLICATE SET
          Used only for seamless mobile auto-scroll
        {% endcomment %}

        {% for block in section.blocks %}
          <a
            href="{{ block.settings.link }}"
            class="logo-item logo-item-clone"
            target="_blank"
            rel="noopener noreferrer"
            aria-hidden="true"
            tabindex="-1"
          >
            {% if block.settings.logo %}
              <img
                src="{{ block.settings.logo | image_url: width: 800 }}"
                alt=""
                width="{{ block.settings.logo.width }}"
                height="{{ block.settings.logo.height }}"
                loading="lazy"
              >
            {% endif %}
          </a>
        {% endfor %}

      </div>

    </div>

  </div>

</section>


<style>

  /* =========================================
     MAIN SECTION
  ========================================= */

  .also-available-section {
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;

    {% if section.settings.bg_image != blank %}
      background-image: url({{ section.settings.bg_image | image_url }});
    {% endif %}

    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }


  /* =========================================
     CONTAINER
  ========================================= */

  .available-container {
    text-align: center;
    max-width: 1480px;
    margin: 0 auto;
    padding: 0 10px;
  }


  /* =========================================
     HEADING
  ========================================= */

  .available-heading {
    font-family: "Rubik", sans-serif;
    font-weight: 700;
    font-size: 48px;
    line-height: 1;
    letter-spacing: 0;
    text-transform: uppercase;
    margin: 0 0 16px;
  }


  /* =========================================
     SUBHEADING
  ========================================= */

  .available-subheading {
    font-size: 18px;
    line-height: 1.4;
    color: #1E1E1E;

    margin-top: 0;
    margin-bottom: 60px;
  }


  /* =========================================
     LOGO WRAPPER
  ========================================= */

  .available-logos-wrapper {
    width: 100%;
  }


  /* =========================================
     LOGO CONTAINER - DESKTOP
  ========================================= */

  .available-logos {
    display: flex;
    justify-content: center;
    align-items: stretch;

    gap: 16px;

    width: 100%;
    margin: 0 auto;
  }


  /* =========================================
     LOGO CARD - DESKTOP
  ========================================= */

  .logo-item {
    display: block;

    width: 100%;
    max-width: 20%;

    border: 1px solid #634b30;
    border-radius: 12px;

    overflow: hidden;

    background: #ffffff;

    text-decoration: none;

    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }


  /* =========================================
     IMAGE
  ========================================= */

  .logo-item img {
    display: block;

    width: 100%;
    height: auto;

    transition: transform 0.3s ease;
  }


  /* =========================================
     DESKTOP HOVER
  ========================================= */

  @media screen and (min-width: 769px) {

    .logo-item:hover {
      transform: translateY(-4px);

      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
    }

    .logo-item:hover img {
      transform: scale(1.04);
    }

    /* Hide cloned logos on desktop */
    .logo-item-clone {
      display: none;
    }

  }


  /* =========================================
     MOBILE
  ========================================= */

  @media screen and (max-width: 768px) {

    .also-available-section {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }


    /* -----------------------------------------
       MOBILE HEADING
    ----------------------------------------- */

    .available-heading {
      font-size: 32px;
      line-height: 1.1;

      margin-bottom: 6px;
    }


    /* -----------------------------------------
       MOBILE SUBHEADING
    ----------------------------------------- */

    .available-subheading {
      font-size: 16px;
      line-height: 1.4;

      margin-bottom: 20px;
    }


    /* -----------------------------------------
       VIEWPORT
       Hides scrollbar + extra content
    ----------------------------------------- */

    .available-logos-wrapper {
      width: 100%;

      overflow: hidden;

      position: relative;
    }


    /* -----------------------------------------
       AUTO SCROLL CONTAINER
    ----------------------------------------- */

    .available-logos {
      display: flex;
      align-items: stretch;
      justify-content: flex-start;

      gap: 8px;

      width: max-content;

      margin: 0;

      animation: mobileLogoScroll 28s linear infinite;

      will-change: transform;
    }


    /* -----------------------------------------
       MOBILE LOGO CARD
    ----------------------------------------- */

    .logo-item {
      flex: 0 0 150px;

      width: 150px;
      max-width: 150px;

      border-radius: 10px;

      border: 1px solid #634b30;
    }


    /* -----------------------------------------
       MOBILE IMAGE
    ----------------------------------------- */

    .logo-item img {
      width: 100%;
      height: auto;

      display: block;
    }


    /* -----------------------------------------
       REMOVE HOVER EFFECT ON MOBILE
    ----------------------------------------- */

    .logo-item:hover {
      transform: none;
      box-shadow: none;
    }


    .logo-item:hover img {
      transform: none;
    }


    /* -----------------------------------------
       HIDE NATIVE SCROLLBAR
    ----------------------------------------- */

    .available-logos-wrapper {
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .available-logos-wrapper::-webkit-scrollbar {
      display: none;
      width: 0;
      height: 0;
    }


    /* -----------------------------------------
       PAUSE WHEN USER TOUCHES
    ----------------------------------------- */

    .available-logos:active {
      animation-play-state: paused;
    }

  }


  /* =========================================
     INFINITE MOBILE ANIMATION
  ========================================= */

  @keyframes mobileLogoScroll {

    0% {
      transform: translateX(0);
    }

    100% {
      transform: translateX(
        calc(
          -50% - 4px
        )
      );
    }

  }


  /* =========================================
     ACCESSIBILITY
  ========================================= */

  @media (prefers-reduced-motion: reduce) {

    .available-logos {
      animation: none;
    }

  }

</style>


{% schema %}

{
  "name": "Also Available On",

  "settings": [

    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "ALSO AVAILABLE ON"
    },

    {
      "type": "text",
      "id": "subheading",
      "label": "Sub-heading",
      "default": "Wherever You Shop, We're There."
    },

    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top (Desktop)",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 60
    },

    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom (Desktop)",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 30
    },

    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top (Mobile)",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 40
    },

    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom (Mobile)",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 20
    }

  ],

  "blocks": [

    {
      "type": "logo",
      "name": "Logo",

      "settings": [

        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo Image"
        },

        {
          "type": "url",
          "id": "link",
          "label": "Logo Link"
        }

      ]
    }

  ],

  "max_blocks": 20,

  "presets": [

    {
      "name": "Also Available On"
    }

  ]

}

{% endschema %}